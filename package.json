{
  "name": "stolbik",
  "private": true,
  "version": "0.2.0",
  "description": "СТОЛБИК — сложение и вычитание столбиком, 2 класс. Mobile-first офлайн PWA.",
  "type": "module",
  "scripts": {
    "pickup": "node scripts/pickup.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:build": "VITE_BASE=/ vite build --outDir preview",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "test:release": "node --test scripts/release-check.test.mjs",
    "content:check": "tsx src/content/check.ts",
    "test:engine": "vitest run src/engine",
    "test:smoke": "vitest run src/tests src/ui",
    "test:boot": "tsx scripts/test-boot.ts",
    "audit:storage": "vitest run src/platform/storage.test.ts",
    "test:qr": "node scripts/qr-verify.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
